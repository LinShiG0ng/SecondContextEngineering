# ===============================================
# 上下文工程演示系统 - 环境变量配置
# ===============================================
#
# ✅ Windows用户配置步骤：
# 1. 复制本文件并重命名为 .env
#    在项目根目录右键 → 复制 → 粘贴 → 重命名为 .env
# 2. 使用记事本或VS Code打开 .env 文件
# 3. 填入你的 API Key（去掉前面的 # 注释符号）
# 4. 保存文件
# 5. 重启 Web 服务器（python -m context_engineering_demo.app）
#
# 📝 注意：.env 文件中不要有空格！
#    正确: LLM_API_KEY=sk-xxxxx
#    错误: LLM_API_KEY = sk-xxxxx (有空格)
#
# ===============================================

# ============ LLM API 配置 ============

# 方式1：使用 OpenAI（推荐）
# 获取 API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

# 方式2：使用 Anthropic Claude（高质量）
# 获取 API Key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# 方式3：使用 Ollama 本地模型（免费，需先安装Ollama）
# 下载: https://ollama.com/download/windows
# 安装后运行: ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434

# 自定义 API Base URL（可选，使用国内镜像时需要）
# LLM_BASE_URL=https://api.openai-proxy.com/v1

# ============ 上下文管理配置 ============

# 最大 Token 限制（推荐 4000-8000）
MAX_TOKENS=8000

# ============ Web 服务器配置 ============

# 端口号（默认 8000）
WEB_PORT=8000


# ===============================================
# 🎯 快速配置示例（去掉注释即可使用）
# ===============================================

# 示例1: OpenAI GPT-3.5（最常用，便宜）
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo

# 示例2: OpenAI GPT-4（更强大）
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo

# 示例3: Claude 3.5 Sonnet（质量高）
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
